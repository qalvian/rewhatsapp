{
  "name": "rewhatsapp",
  "version": "1.0.0",
  "description": "Production-grade, zero-runtime-dependency, privacy-first WhatsApp chat replayer",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "serve": "node scripts/dev-server.js",
    "dev": "node scripts/dev-server.js"
  },
  "keywords": [
    "whatsapp",
    "chat",
    "replayer",
    "privacy-first",
    "vanilla-js",
    "pwa"
  ],
  "author": "qalvian",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.20.0",
    "postcss": "^8.5.31",
    "prettier": "^3.5.0",
    "puppeteer-core": "^25.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
